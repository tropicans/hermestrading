# HERMES Trading — contoh konfigurasi.
# Salin ke .env dan isi nilainya. JANGAN commit .env.

# --- Mode ---
TRADING_MODE=PAPER
EXCHANGE_ID=indodax
TRADING_SYMBOL=PAXG/IDR
EXCHANGE_API_KEY=
EXCHANGE_SECRET_KEY=
PAPER_INITIAL_BALANCE=150000000.0

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Risiko ---
MAX_CAPITAL_RISK_PER_TRADE=0.05
MAX_CONCURRENT_POSITIONS=1
# Batas rugi harian sebagai fraksi ekuitas (0 = pakai DAILY_MAX_DRAWDOWN absolut)
DAILY_DRAWDOWN_EQUITY_PCT=0.03
DAILY_MAX_DRAWDOWN=-2500000.0

# --- Biaya & eksekusi (harus konsisten dengan fee Indodax) ---
INDODAX_TAKER_FEE=0.0022
SLIPPAGE_PAD_PCT=0.0005
ORDER_FILL_TIMEOUT_SEC=20
ROUNDTRIP_COST_PCT=0.0074

# --- Parameter strategi (pair IDR) ---
ATR_SL_MULT_IDR=2.0
ATR_TP_MULT_IDR=4.0
TP_RR_TARGET_IDR=2.2
MIN_SL_PCT_IDR=0.0090
MAX_SPREAD_PCT=0.0035
MIN_NET_RR=1.5
# Fib guard adaptif: saat tren naik (EMA5 > EMA13) guard dilonggarkan.
# 100 = nonaktif saat uptrend; tetap 76.4% saat sideways.
FIB_MAX_ZONE_TREND=100.0
FIB_MAX_ZONE_RANGE=76.4

# --- Parameter strategi (non-IDR) ---
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
TP_RR_TARGET=2.0
MIN_SL_PCT=0.0040

# --- Trailing stop ---
TRAILING_ARM_PCT=0.0120
TRAILING_DISTANCE_PCT=0.0040

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Lainnya ---
DB_PATH=/app/data/trading.db
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30
